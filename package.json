{
  "name": "0xauto-mcp-a2a-demo",
  "version": "0.1.0",
  "private": true,
  "description": "0xAuto / AutoA2A - a runnable demo of an MCP-native, Agent-to-Agent (A2A) DeFi automation engine.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @0xauto/web",
    "build": "npm run build --workspace @0xauto/mcp-server && npm run build --workspace @0xauto/web",
    "start": "npm run start --workspace @0xauto/web",
    "lint": "npm run lint --workspace @0xauto/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @0xauto/mcp-server",
    "mcp": "npm run start --workspace @0xauto/mcp-server",
    "quant:demo": "npm run quant:demo --workspace @0xauto/mcp-server --",
    "quant:test": "npm run test --workspace @0xauto/mcp-server"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
